# ---- Shared ----
NODE_ENV=development

# ---- Backend ----
PORT=4000
DATABASE_URL=postgresql://adhd:adhd@localhost:5432/adhd_care_hub?schema=public
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=http://localhost:5173
# Field-level encryption key for health data (32 bytes, base64)
PHI_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LOG_LEVEL=info

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:4000/api/v1
